# Configuração Opcional de Nuvem (Vercel KV / Upstash Redis Gratuito)
# Adicione estas variáveis no painel da Vercel (Storage > Upstash Redis / KV)
KV_REST_API_URL="https://seu-banco-redis.upstash.io"
KV_REST_API_TOKEN="seu-token-upstash-aqui"

# Ou usando a nomenclatura padrão do Upstash Marketplace:
UPSTASH_REDIS_REST_URL="https://seu-banco-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-upstash-aqui"

